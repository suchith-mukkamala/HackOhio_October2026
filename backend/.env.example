# Copy to backend/.env and fill in. Never commit the real .env.

# SQLite locally; RDS Postgres in production, e.g.
# postgresql+psycopg://user:pass@host:5432/keystone
DATABASE_URL=sqlite:///./keystone.db

# Any long random string: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

# GitHub OAuth app (github.com/settings/developers)
# Callback URL: http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# Where the browser goes after sign-in (Vite dev server locally)
FRONTEND_URL=http://localhost:5173

# Claude, used for auto-docs drafts
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Enables the "Sign in as..." persona picker used in the demo video
DEMO_MODE=true

# Set to true in production (HTTPS)
SECURE_COOKIES=false
