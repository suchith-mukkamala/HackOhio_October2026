# Copy to backend/.env and fill in. Never commit the real .env.

# AWS RDS Postgres (RDS console -> Databases -> hackohio2026 -> Connectivity & security).
# There is no SQLite fallback: the backend won't start without these.
# Wrap the password in single quotes if it has special characters.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# Any long random string: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

# GitHub OAuth app (github.com/settings/developers)
# Callback URL: http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# Google OAuth client (console.cloud.google.com → APIs & Services → Credentials)
# Authorized redirect URI: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the browser goes after sign-in (Vite dev server locally)
FRONTEND_URL=http://localhost:5173

# OpenAI, used for log drafts from commits and resume reading (platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Enables the "Sign in as..." persona picker used in the demo video
DEMO_MODE=false

# Set to true in production (HTTPS)
SECURE_COOKIES=false
